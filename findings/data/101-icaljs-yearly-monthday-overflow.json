 "cases_id": "7bd9731d3a48c0155ba35f943d43756ff2ec8ae69cced3464d45940e62e53f5b",
 "probes": {
  "C-byday-5th": {
   "dtstart": "20230115T090000",
   "group": "C",
   "limit": 4,
   "note": "THE INTERNAL CONTROL. expand_year_days's BYDAY branches bounds-check (`if (month_day <= daysInMonth)`); a 5th Sunday that April does not have is dropped, not overflowed. Same function, same year, opposite handling",
   "rrule": "FREQ=YEARLY;BYMONTH=4;BYDAY=5SU"
  },
  "C-byday-5th-2": {
   "dtstart": "20230115T090000",
   "group": "C",
   "limit": 4,
   "note": "same internal control in February, and the one probe where ical.js STOPS EARLY: a 5th Monday in February needs a leap year beginning on a Monday (2044, 2072, 2112, 2140), and ical.js returns only the first two. Every date it does return is correct, so the BYDAY bounds check still holds. The early stop is next_year() returning 0 when a single year expands empty; it is NOT this finding's defect and is NOT claimed here",
   "rrule": "FREQ=YEARLY;BYMONTH=2;BYDAY=5MO"
  },
  "C-byyearday": {
   "dtstart": "20230115T090000",
   "group": "C",
   "limit": 4,
   "note": "control: an out-of-range BYYEARDAY is NOT overflowed into the next year",
   "rrule": "FREQ=YEARLY;BYYEARDAY=366"
  },
  "C-monthly-30": {
   "dtstart": "20240229T090000",
   "group": "C",
   "limit": 6,
   "note": "control: mixed sign at MONTHLY, also correct",
   "rrule": "FREQ=MONTHLY;BYMONTHDAY=31,-1"
  },
  "C-monthly-31": {
   "dtstart": "20240415T090000",
   "group": "C",
   "limit": 6,
   "note": "control: THE SAME impossible day at FREQ=MONTHLY is handled correctly -- ical.js skips the short months. FREQ=YEARLY is load-bearing",
   "rrule": "FREQ=MONTHLY;BYMONTHDAY=31"
  },
  "C-valid-2-28": {
   "dtstart": "20230115T090000",
   "group": "C",
   "limit": 4,
   "note": "control: February 28 always exists",
   "rrule": "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=28"
  },
  "C-valid-4-30": {
   "dtstart": "20230115T090000",
   "group": "C",
   "limit": 4,
   "note": "control: the LARGEST day April does have. No overflow. The trigger is the range check, not the size of the number",
   "rrule": "FREQ=YEARLY;BYMONTH=4;BYMONTHDAY=30"
  },
  "D-in-11-31": {
   "dtstart": "20231101T090000",
   "group": "D",
