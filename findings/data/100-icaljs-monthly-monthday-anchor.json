 "probes": {
  "C-int1pos": {
   "dtstart": "20260315T090000",
   "group": "C",
   "limit": 3,
   "note": "S1-int1 with a positive spelling -> accepted. The rejection is not about INTERVAL=1",
   "rrule": "FREQ=MONTHLY;BYMONTHDAY=31;BYDAY=SU"
  },
  "C-jun": {
   "dtstart": "20260615T090000",
   "group": "C",
   "limit": 3,
   "note": "June DTSTART: anchored into 31-day May, so no month is longer -> accepted (wrong phase only)",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=-1;BYDAY=SU"
  },
  "C-nobyday": {
   "dtstart": "20260131T090000",
   "group": "C",
   "limit": 4,
   "note": "099's C-monthly, reproduced: WITHOUT BYDAY the same parts are CORRECT. BYDAY is the difference",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=-1"
  },
  "C-nomonthday": {
   "dtstart": "20260131T090000",
   "group": "C",
   "limit": 4,
   "note": "WITHOUT BYMONTHDAY a negative ordinal BYDAY is correct: not about negatives in general",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYDAY=-1SA"
  },
  "C-order": {
   "dtstart": "20260131T090000",
   "group": "C",
   "limit": 4,
   "note": "SAME SET as S2-jan's superset, positive FIRST -> correct. Only setup_defaults' [0] is read",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=15,-1;BYDAY=SA"
  },
  "C-pos": {
   "dtstart": "20260131T090000",
   "group": "C",
   "limit": 4,
   "note": "SAME MEANING for January, positive spelling -> correct phase. The SIGN is load-bearing",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=31;BYDAY=SA"
  },
  "S1-int1": {
   "dtstart": "20260315T090000",
   "group": "S1",
   "limit": 3,
   "note": "INTERVAL=1 does NOT hide S1: still REJECTED. S1 reaches the commonest rule shape",
   "rrule": "FREQ=MONTHLY;BYMONTHDAY=-1;BYDAY=SU"
  },
  "S1-mar": {
   "dtstart": "20260315T090000",
   "group": "S1",
   "limit": 3,
   "note": "March DTSTART: anchored into 28-day February, lands on a 31-day month -> REJECTED",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=-1;BYDAY=SU"
  },
  "S1-md5": {
   "dtstart": "20260315T090000",
   "group": "S1",
   "limit": 3,
   "note": "-5 also anchors into February, but lands on a day <= 28 -> accepted, and WRONG PHASE",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=-5;BYDAY=SU"
  },
  "S1-two": {
   "dtstart": "20260315T090000",
   "group": "S1",
   "limit": 3,
   "note": "a second, positive value does not help: only the FIRST listed value is read -> REJECTED",
   "rrule": "FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=-1,5;BYDAY=SU"
  },
  "S2-int2": {
   "dtstart": "20260131T090000",
   "group": "S2",
   "limit": 4,
   "note": "INTERVAL=2: offsets 1 mod 2, and DTSTART 2026-01-31 -- itself a valid match -- is DROPPED",
   "rrule": "FREQ=MONTHLY;INTERVAL=2;BYMONTHDAY=-1;BYDAY=SA"
  },
  "S2-jan": {
   "dtstart": "20260131T090000",
   "group": "S2",
   "limit": 4,
   "note": "corpus case e1b4925a5263's shape. Accepted, and every month offset is 2 mod 3",
