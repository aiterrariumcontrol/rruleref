 "probes": {
  "A-dtstart": {
   "dtstart": "20800101T090000",
   "group": "A",
   "limit": 8,
   "note": "DECIDING, and it is the asymmetry: the SAME rule from 2080 must cross the SAME 31 empty iterations to reach 2112 -- and it does, because that search happens in init(), which is not bounded. Past the gap it is fully correct. Bounded and unbounded search for the same thing in the same class",
   "rrule": "FREQ=YEARLY;BYMONTH=2;BYDAY=5MO"
  },
  "C-interval2": {
   "dtstart": "20260101T090000",
   "group": "C",
   "limit": 6,
   "note": "DECIDING: INTERVAL=2 crosses the SAME 40 calendar years correctly, in 19 iterations. The bound counts ITERATIONS, not years",
   "rrule": "FREQ=YEARLY;INTERVAL=2;BYMONTH=2;BYDAY=5MO"
  },
  "C-leaponly": {
   "dtstart": "20260101T090000",
   "group": "C",
   "limit": 8,
   "note": "leap years alone, via BYYEARDAY=366 rather than BYMONTHDAY=29 (which finding 101 already shows ical.js mishandles): gaps of at most 8, no loss",
   "rrule": "FREQ=YEARLY;BYYEARDAY=366"
  },
  "C-monthly": {
   "dtstart": "20260101T090000",
   "group": "C",
   "limit": 6,
   "note": "the MONTHLY analogue of the identical conjunction is CORRECT. Its own bound is 336, and BYMONTH is a contracting rule checked outside next_month(), so invalid_count is reset every month. FREQ=YEARLY is load-bearing",
   "rrule": "FREQ=MONTHLY;BYMONTH=2;BYMONTHDAY=29;BYDAY=MO"
  },
  "D-5mo": {
   "dtstart": "20260101T090000",
   "group": "D",
   "limit": 8,
   "note": "a fifth Monday in February needs a leap year whose Feb 1 is a Monday: 2044, 2072, then nothing until 2112. ical.js stops at 2072",
   "rrule": "FREQ=YEARLY;BYMONTH=2;BYDAY=5MO"
  },
  "D-count": {
   "dtstart": "20260101T090000",
   "group": "D",
   "limit": 6,
   "note": "COUNT=6 returns 2. A caller who asked for a fixed count gets a short series with no error: the loss is SILENT",
   "rrule": "FREQ=YEARLY;BYMONTH=2;BYDAY=5MO;COUNT=6"
  },
  "D-feb29mon": {
   "dtstart": "20260101T090000",
   "group": "D",
   "limit": 8,
   "note": "a different rule text reaching the same rare conjunction, stopped at the same year: the mechanism is the empty run, not the BYDAY ordinal",
   "rrule": "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=29;BYDAY=MO"
  },
  "D-interval3": {
   "dtstart": "20260101T090000",
   "group": "D",
   "limit": 6,
   "note": "INTERVAL=3 keeps only 2044 -- the next reachable year is 2140, 32 iterations away. A LARGER interval truncates EARLIER in calendar terms",
   "rrule": "FREQ=YEARLY;INTERVAL=3;BYMONTH=2;BYDAY=5MO"
  }
 }
